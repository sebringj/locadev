# Compose substitution values. Copy to .env on first run:
#   cp .env.example .env
#
# ACCEPT_EULA=Y acknowledges the Microsoft EULAs for BOTH SQL Server for Linux
# and the Service Bus emulator (dev/test only, no SLA).

ACCEPT_EULA=Y
MSSQL_SA_PASSWORD=Sandbox!Dev2026
EMULATOR_HTTP_PORT=5300
SQL_WAIT_INTERVAL=20

# Bridge backends: fake | ollama | claude-cli (chat only)
# CHAT_BACKEND=claude-cli is host-only (cannot run inside the container).
CHAT_BACKEND=fake
EMB_BACKEND=fake
OLLAMA_BASE=http://host.docker.internal:11434
OLLAMA_CHAT_MODEL=qwen2.5:7b-instruct
OLLAMA_EMBED_MODEL=nomic-embed-text
EMBED_DIM=1536

# Empty = plain echo brain for teams tests. Unset or bridge URL for LLM answers.
#ECHO_BOT_BRAIN=

SEED_BUCKET=locadev-demo
PGLITE_DATA_DIR=/data
